# ─────────────────────────────────────────────────────────
# 프론트엔드 환경변수 (.env.example)
#
# 이 파일을 .env로 복사해서 값을 채워 사용.
# ─────────────────────────────────────────────────────────

# 백엔드 API base URL
VITE_API_URL=http://localhost:3000

# Kakao JavaScript Key
VITE_KAKAO_CLIENT_ID=

# Sentry 에러 추적 (선택) — 비워두면 비활성. 로컬 개발에서는 보통 비워둔다.
VITE_SENTRY_DSN=

# 관리자 모니터링 화면의 "Sentry 열기" 링크 주소 (선택)
VITE_SENTRY_PROJECT_URL=


# Microsoft Clarity 행태 분석 (선택) — 비워두면 완전 비활성.
# 🔴 개인정보처리방침 시행일(2026-08-11) **전에는 주입 금지** — 고지 없는 수집이 된다.
VITE_CLARITY_PROJECT_ID=
